# --- credenciais (as MESMAS do repo jornada_dados, de proposito) ---
SUDOERS_USER=sudoers
SUDOERS_PASS=sudoers
NEO4J_AUTH=neo4j/sudoers123

# --- portas no SEU host ---------------------------------------------------
# Trocamos algumas do padrao para NAO colidir com o repo jornada_dados
# (que ja usa 9000/MinIO, 8080/Airflow, 5432, 5433, 9092, 8083, 2181).
PORTA_MONGO=27017
PORTA_MONGO_UI=8091
PORTA_REDIS=6380
PORTA_NEO4J_HTTP=7474
PORTA_NEO4J_BOLT=7687
PORTA_CASSANDRA=9042
PORTA_CLICKHOUSE_HTTP=8123
PORTA_CLICKHOUSE_NATIVA=9010
PORTA_STREAMLIT=8501
PORTA_METABASE=3010

# --- universo de dados (mude e TODOS os bancos mudam juntos) --------------
SEMENTE=42
N_PESSOAS=500
N_PRODUTOS=200
N_PEDIDOS=5000

# --- limites de memoria (notebook de 8GB sobrevive) ----------------------
CASSANDRA_HEAP=1G
NEO4J_HEAP=1G
